# ==============================================================================
# UniCast ("Your Campus Pulse") — Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Connection Pooling URL (PgBouncer) for application queries & serverless runtime
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-mute-band-b4jk8eze-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct Connection URL (without pooler) for Prisma schema migrations & db push
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-mute-band-b4jk8eze.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="unicast-campus-pulse-jwt-production-secret-2026-uganda"

# ------------------------------------------------------------------------------
# 3. LIVE RADIO STREAMING INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Primary Icecast/Shoutcast/Zeno.fm stream mount URL (HTTPS required in modern browsers)
NEXT_PUBLIC_RADIO_STREAM_URL="https://stream.zeno.fm/f3wvbbqmdg8uv"
NEXT_PUBLIC_STREAM_URL="https://stream.zeno.fm/f3wvbbqmdg8uv"

# Optional fallback stream URL (plays when primary live studio is disconnected)
NEXT_PUBLIC_FALLBACK_STREAM_URL="https://stream.zeno.fm/f3wvbbqmdg8uv"

# ------------------------------------------------------------------------------
# 4. BRANDING DEFAULTS (Overridden by Database RadioSettings)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STATION_NAME="UniCast"
NEXT_PUBLIC_STATION_FREQUENCY="Online Radio Network"
NEXT_PUBLIC_STATION_TAGLINE="Your Campus Pulse"

# ------------------------------------------------------------------------------
# 5. SERVER TIMEZONE
# ------------------------------------------------------------------------------
TZ="Africa/Kampala"
