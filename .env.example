# Database
DATABASE_URL="postgresql://user:password@host:5432/kyambogoradio?sslmode=require"
# Or SQLite: DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"

# Audio Stream URLs
