# ==============================================================================
# UniCast ("Your Campus Pulse") — Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development (SQLite file):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL example):
# DATABASE_URL="postgresql://unicast_user:STRONG_PASSWORD@db.unicast.radio:5432/unicast_prod?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-64-character-production-secret-key"

# ------------------------------------------------------------------------------
# 3. LIVE RADIO STREAMING INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Primary Icecast/Shoutcast/Zeno.fm stream mount URL (HTTPS required in modern browsers)
NEXT_PUBLIC_RADIO_STREAM_URL="https://stream.unicast.radio/live"
NEXT_PUBLIC_STREAM_URL="https://stream.unicast.radio/live"

# Optional fallback stream URL (plays when primary live studio is disconnected)
NEXT_PUBLIC_FALLBACK_STREAM_URL="https://stream.unicast.radio/backup"

# ------------------------------------------------------------------------------
# 4. BRANDING DEFAULTS (Overridden by Database RadioSettings)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STATION_NAME="UniCast"
NEXT_PUBLIC_STATION_FREQUENCY="Online Radio Network"
NEXT_PUBLIC_STATION_TAGLINE="Your Campus Pulse"

# ------------------------------------------------------------------------------
# 5. SERVER TIMEZONE
# ------------------------------------------------------------------------------
TZ="Africa/Kampala"
