datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("PRESENTER") // SUPER_ADMIN, RADIO_ADMIN, PRESENTER, EDITOR
  avatar       String?
  presenter    Presenter?
  articles     Article[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Presenter {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  roleTitle   String      // e.g. "Senior Radio Host & DJ"
  bio         String
  avatar      String
  socialLinks String?     // JSON string { twitter, instagram, linkedin }
  isActive    Boolean     @default(true)
  userId      String?     @unique
  user        User?       @relation(fields: [userId], references: [id])
  programmes  Programme[]
  podcasts    Podcast[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProgrammeCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  color       String      @default("#06B6D4")
  programmes  Programme[]
}

model Programme {
  id          String            @id @default(uuid())
  title       String
  slug        String            @unique
  tagline     String
  description String
  coverImage  String
  categoryId  String
  category    ProgrammeCategory @relation(fields: [categoryId], references: [id])
  presenterId String
  presenter   Presenter         @relation(fields: [presenterId], references: [id])
  schedules   Schedule[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Schedule {
  id          String    @id @default(uuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  dayOfWeek   String    // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  startTime   String    // "HH:mm" 24h format e.g. "08:00"
  endTime     String    // "HH:mm" e.g. "10:00"
  isLive      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dayOfWeek, startTime])
}

model PodcastCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  podcasts    Podcast[]
}

model Podcast {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  description String
  audioUrl    String
  duration    Int             // seconds
  coverImage  String
  categoryId  String
  category    PodcastCategory @relation(fields: [categoryId], references: [id])
  presenterId String
  presenter   Presenter       @relation(fields: [presenterId], references: [id])
  isPublished Boolean         @default(true)
  publishedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SongRequest {
  id          String    @id @default(uuid())
  studentName String
  course      String?
  songTitle   String
  artist      String
  dedication  String?
  status      String    @default("PENDING") // PENDING, APPROVED, PLAYED, REJECTED
  adminNote   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ArticleCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  articles    Article[]
}

model Article {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  excerpt     String
  content     String
  coverImage  String
  categoryId  String
  category    ArticleCategory @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User            @relation(fields: [authorId], references: [id])
  isFeatured  Boolean         @default(false)
  isPublished Boolean         @default(true)
  publishedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  priority  String    @default("NORMAL") // URGENT, HIGH, NORMAL
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RadioSetting {
  id                   String   @id @default("station_settings")
  stationName          String   @default("Kyambogo Radio")
  tagline              String   @default("The Voice of Kyambogo University")
  frequency            String   @default("107.4 FM & Online")
  streamUrl            String   @default("https://stream.zeno.fm/f3wvbbqmdg8uv") // Default high-availability live stream mount point
  fallbackStreamUrl    String?
  isLiveManualOverride Boolean  @default(false)
  contactEmail         String   @default("radio@kyu.ac.ug")
  contactPhone         String   @default("+256 700 000000")
  socialLinks          String?  // JSON string
  updatedAt            DateTime @updatedAt
}

model ListenerPing {
  id          String   @id @default(uuid())
  sessionHash String
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
